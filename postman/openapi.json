                  "minLength":1
               },
               "year":{
                  "type":"integer",
                  "format":"int32"
               },
               "price":{
                  "type":"number",
                  "format":"double",
                  "minimum":0.0
               },
               "genre":{
                  "type":"string",
                  "minLength":1
               },
               "authors":{
                  "type":"array",
                  "items":{
                     "$ref":"#/components/schemas/AuthorDto"
                  },
                  "maxItems":2147483647,
                  "minItems":1
