                  "format":"int32"
               },
               "error":{
                  "type":"string"
               },
               "message":{
                  "type":"string"
               },
               "timestamp":{
                  "type":"string",
                  "format":"date-time"
               },
               "fieldErrors":{
                  "type":"object",
                  "additionalProperties":{
                     "type":"string"
                  }
               }
            }
         },
         "AuthorDto":{
            "type":"object",
            "properties":{
